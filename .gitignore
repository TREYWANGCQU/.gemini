# .gitignore
# ==========================================
# 运行时数据与动态会话（完全隔离）
# ==========================================
/antigravity/
/antigravity-ide/
/antigravity-browser-profile/

# ==========================================
# 外部导入插件与根目录通用技能库
# （保留 config/skills/ 下的自建技能）
# ==========================================

/skills/
/config/mcp_config.json
/config/projects
# ==========================================
# 图片、媒体与大型二进制文件
# ==========================================
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.ico
*.pdf
*.zip
*.tar.*
*.7z

# ==========================================
# 临时、缓存与中间产物
# ==========================================
**/scratch/
**/crashes/
**/browser_recordings/
**/brain/
**/logs/
*.log
*.tmp
*.pb
*.pbtxt

# ==========================================
# Python 与 Node 运行缓存 (脚本/环境)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
node_modules/

# ==========================================
# 操作系统与通用编辑器临时文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

bin/
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SVGDesignTokensV2",
  "description": "Schema for project-local SVG design tokens, multi-scenario color contracts, and typography constraints",
  "type": "object",
  "required": ["name", "aspectRatio", "palette", "typography"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "scenario": {
      "type": "string",
      "enum": ["academic-paper", "presentation-deck", "saas-enterprise", "editorial-minimal", "tech-console"],
      "default": "presentation-deck"
    },
    "mode": {
      "type": "string",
      "enum": ["light", "dark"],
      "default": "dark"
    },
    "aspectRatio": {
      "type": "string",
      "enum": ["16:9", "4:3", "1:1", "21:9"],
      "default": "16:9"
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 400 },
        "height": { "type": "integer", "minimum": 300 },
        "padding": { "type": "integer", "minimum": 0 }
      }
    },
    "palette": {
      "type": "object",
      "required": ["primary", "bgBase", "bgCard", "textMain", "textSecondary"],
      "properties": {
        "primary": { "type": "string" },
        "primaryHover": { "type": "string" },
        "bgBase": { "type": "string" },
        "bgCard": { "type": "string" },
        "borderCard": { "type": "string" },
        "textMain": { "type": "string" },
        "textSecondary": { "type": "string" },
        "accent": { "type": "string" },
        "categorical": {
          "type": "array",
          "description": "常态图表与分类色 (最多4色)，严格与告警解耦，严禁包含红黄绿告警杂色",
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "functional": {
          "type": "object",
          "properties": {
            "warning": { "type": "string" },
            "danger": { "type": "string" },
            "success": { "type": "string" }
          }
        },
        "decorative": {
          "type": "object",
          "properties": {
            "badgeFill": { "type": "string" },
            "badgeStroke": { "type": "string" },
            "iconWeight": { "type": "number" }
          }
        }
      }
    },
    "patterns": {
      "type": "object",
      "properties": {
        "academicHatch": { "type": "boolean", "description": "启用学术图表网纹与虚线填充支持" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["fontFamilyBase", "scale"],
      "properties": {
        "fontFamilyBase": { "type": "string" },
        "scale": {
          "type": "object",
          "required": ["floor", "sm", "base", "lg", "xl"],
          "properties": {
            "floor": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" },
            "sm": { "type": "string", "pattern": "^(1[4-9]|[2-9][0-9])px$" },
            "base": { "type": "string", "pattern": "^(1[6-9]|[2-9][0-9])px$" },
            "lg": { "type": "string", "pattern": "^(1[8-9]|[2-9][0-9])px$" },
            "xl": { "type": "string", "pattern": "^(2[0-9]|[3-9][0-9])px$" },
            "hero": { "type": "string", "pattern": "^(2[4-9]|[3-9][0-9])px$" }
          }
        },
        "leading": {
          "type": "object",
          "properties": {
            "tight": { "type": "number", "minimum": 1.1 },
            "normal": { "type": "number", "minimum": 1.3 },
            "relaxed": { "type": "number", "minimum": 1.5 }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "properties": {
        "rx": { "type": "number" },
        "strokeWidth": { "type": "number" },
        "paddingInner": { "type": "number" }
      }
    },
    "qualityGate": {
      "type": "object",
      "properties": {
        "maxColors": { "type": "integer", "minimum": 1 },
        "checkAspectRatio": { "type": "string" },
        "forbiddenTokens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minFontSize": { "type": "number", "minimum": 12.0 }
      }
    },
    "exemptions": {
      "type": "object",
      "properties": {
        "allowMicroFontForSparklines": { "type": "boolean" },
        "exemptionAttribute": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignTokensSchema",
  "description": "Schema definition for design-tokens.json enforced by web-theme-curator",
  "type": "object",
  "required": ["name", "palette", "typography"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "remBase": {
      "type": "number",
      "default": 16,
      "description": "Base px per rem (default 16)"
    },
    "palette": {
      "type": "object",
      "required": ["primary", "bgBase", "textMain", "textSecondary", "auxiliary", "chartPalette"],
      "properties": {
        "primary": { "type": "string" },
        "primaryHover": { "type": "string" },
        "bgBase": { "type": "string" },
        "bgCard": { "type": "string" },
        "textMain": { "type": "string" },
        "textSecondary": { "type": "string" },
        "border": { "type": "string" },
        "auxiliary": {
          "type": "object",
          "description": "严格约束不超过3个语义辅助色 (1+3契约: warning, danger, success)",
          "required": ["warning", "danger", "success"],
          "additionalProperties": false,
          "properties": {
            "warning": { "type": "string" },
            "danger": { "type": "string" },
            "success": { "type": "string" }
          }
        },
        "chartPalette": {
          "type": "array",
          "description": "图表色板必须严格限定为 [Primary, Aux1, Aux2, Aux3]，总数 <= 4",
          "maxItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["fontFamilyBase", "scale"],
      "properties": {
        "fontFamilyBase": { "type": "string" },
        "scale": {
          "type": "object",
          "required": ["floor", "base"],
          "properties": {
            "floor": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" },
            "sm": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" },
            "base": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" },
            "lg": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" },
            "xl": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" },
            "2xl": { "type": "string", "pattern": "^(1[2-9]|[2-9][0-9])px$" }
          }
        },
        "leading": {
          "type": "object",
          "properties": {
            "tight": { "type": "number" },
            "normal": { "type": "number" },
            "relaxed": { "type": "number" }
          }
        }
      }
    }
  }
}
